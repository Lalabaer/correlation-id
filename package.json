{
    "name": "correlation-id",
    "version": "1.0.0",
    "description": "Configurable correlation IDs for Node.js and the browser: validated inbound IDs, UUIDv7 generation, AsyncLocalStorage context, and adapters for HTTP, fetch, Axios, and Kafka.",
    "license": "MIT",
    "type": "module",
    "packageManager": "yarn@4.10.2",
    "engines": {
        "node": ">=22"
    },
    "exports": {
        ".": {
            "browser": {
                "types": "./dist/browser.d.ts",
                "default": "./dist/browser.js"
            },
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./browser": {
            "types": "./dist/browser.d.ts",
            "default": "./dist/browser.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rimraf dist && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "check:dist": "yarn build && git diff --exit-code -- dist"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/express": "^5.0.3",
        "@types/node": "^22.10.5",
        "@vitest/coverage-v8": "^4.1.5",
        "axios": "^1.12.2",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "express": "^5.2.1",
        "fastify": "^5.6.0",
        "prettier": "^3.8.3",
        "rimraf": "^6.0.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.1",
        "vitest": "^4.1.5"
    },
    "keywords": [
        "correlation-id",
        "request-id",
        "asynclocalstorage",
        "uuidv7",
        "fastify",
        "express",
        "axios",
        "kafka",
        "observability"
    ]
}
